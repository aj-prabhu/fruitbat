    {
      "text": "The park hosts 17 bat species.",
      "start": 0,
      "end": 1173,
      "audioStart": 0,
      "audioEnd": 2.725
    },
    {
      "text": "Eastern red bats and hoary bats roost in trees.",
      "start": 0,
      "end": 1173,
      "audioStart": 2.725,
      "audioEnd": 6.225
    },
    {
      "text": "Bats are mammals, which means they give live birth to their young (do not lay eggs).",
      "start": 0,
      "end": 1173,
      "audioStart": 6.225,
      "audioEnd": 11.35
    },
    {
      "text": "Bats are the only true flying mammals.",
      "start": 0,
      "end": 1173,
      "audioStart": 11.35,
      "audioEnd": 14.175
    },
    {
      "text": "Brazilian free-tailed bats weigh about 1/2 ounce (13 g).",
      "start": 0,
      "end": 1173,
      "audioStart": 14.175,
      "audioEnd": 18.75
    }
  ]
